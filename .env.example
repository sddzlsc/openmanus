# ---- control plane ----
PORT=8787
HOST=127.0.0.1
# memory (default, no external deps) | postgres
STORE=memory
DATABASE_URL=postgres://wiwana:wiwana@127.0.0.1:5432/wiwana
JWT_SECRET=dev-secret-change-me
# mock (default, no docker needed) | docker
SANDBOX_PROVIDER=mock
# sandbox image + docker network (production: docker network create wiwana-sandbox)
SANDBOX_IMAGE=wiwana/sandbox:0.1.0
SANDBOX_NETWORK=wiwana-sandbox
SANDBOX_CPUS=2
SANDBOX_MEMORY_MB=4096
# dsh execution inside the sandbox
DSH_BINARY=dsh
DSH_PROFILE=wiwana-task
DSH_TASK_TIMEOUT_MS=1200000
# where per-task/per-project workspaces live
WORKSPACE_ROOT=./data/workspaces
# public domains (production routing)
APP_DOMAIN=app.wiwana.local
API_DOMAIN=api.wiwana.local
PREVIEW_DOMAIN=wiwana.local
# per-user quota defaults
QUOTA_DAILY_TOKENS=200000
QUOTA_DAILY_IMAGES=20
QUOTA_DAILY_VIDEOS=3
QUOTA_MAX_RUNNING_TASKS=1
# ---- upstream providers (sandbox side) ----
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
KELING_API_KEY=
MUSIC_API_KEY=
# ---- integrations (optional, M4) ----
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
WECHAT_OPEN_APP_ID=
WECHAT_OPEN_APP_SECRET=
